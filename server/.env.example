# ============================================================
# SAMBHRAMA GOLD COMPANY — Server Environment Configuration
# ============================================================

# Server Port and Environment
PORT=4000
NODE_ENV=development

# Allowed Frontend Origin for CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173

# PostgreSQL Database Connection URL
# Example: postgresql://postgres:password@localhost:5432/sambhrama_gold?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/sambhrama_gold?schema=public"

# Session Configuration
SESSION_COOKIE_NAME=sambhrama_admin_session
SESSION_TTL_HOURS=12
COOKIE_SECURE=false

# First Administrator Setup (used ONLY by `npm run seed:admin`)
# Never hardcode credentials in code; set these in your local .env before running seed:admin
ADMIN_INITIAL_EMAIL=
ADMIN_INITIAL_NAME="Sambhrama Administrator"
ADMIN_INITIAL_PASSWORD=

# Optional SMTP Email Notification Configuration (for Enquiry Notifications)
# Leave blank if email notifications are not yet configured
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="Sambhrama Gold Company <no-reply@sambhramagold.com>"
ENQUIRY_NOTIFICATION_TO=
